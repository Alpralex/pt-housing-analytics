createOrReplace

	/// Folder that holds the Parquet files, with a trailing backslash. Change it in Transform data > Manage parameters.
	expression DataFolder = "C:\\pt-housing-analytics\\exports\\" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

		annotation PBI_ResultType = Text

	table dim_country

		column geo
			dataType: string
			isKey
			summarizeBy: none
			sourceColumn: geo

		column country_name
			dataType: string
			summarizeBy: none
			sourceColumn: country_name
			sortByColumn: sort_order

		column country_group
			dataType: string
			summarizeBy: none
			sourceColumn: country_group

		column sort_order
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: sort_order

		partition dim_country = m
			mode: import
			source =
					let
						Source = Parquet.Document ( File.Contents ( DataFolder & "dim_country.parquet" ) )
					in
						Source

	table dim_quarter

		column quarter_start
			dataType: dateTime
			isKey
			formatString: yyyy-mm-dd
			summarizeBy: none
			sourceColumn: quarter_start

		column year
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: year

		column quarter
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: quarter

		column quarter_label
			dataType: string
			summarizeBy: none
			sourceColumn: quarter_label
			sortByColumn: quarter_start

		partition dim_quarter = m
			mode: import
			source =
					let
						Source = Parquet.Document ( File.Contents ( DataFolder & "dim_quarter.parquet" ) )
					in
						Source

	table dim_year

		column year
			dataType: int64
			isKey
			formatString: 0
			summarizeBy: none
			sourceColumn: year

		partition dim_year = m
			mode: import
			source =
					let
						Quarters = Parquet.Document ( File.Contents ( DataFolder & "dim_quarter.parquet" ) ),
						Annual = Parquet.Document ( File.Contents ( DataFolder & "mart_affordability.parquet" ) ),
						AllYears = List.Combine ( { Quarters[year], Annual[year] } ),
						FirstYear = List.Min ( AllYears ),
						LastYear = List.Max ( AllYears ),
						Source = Table.FromColumns ( { { FirstYear .. LastYear } }, type table [ year = Int64.Type ] )
					in
						Source

	table fct_house_prices

		/// House price index, 2015 = 100, by dwelling type (use dwelling_type as legend).
		measure 'House Price Index by Type' = AVERAGE ( fct_house_prices[hpi_2015] )
			formatString: 0.0
			displayFolder: Prices

		column geo
			dataType: string
			summarizeBy: none
			sourceColumn: geo

		column quarter_start
			dataType: dateTime
			formatString: yyyy-mm-dd
			summarizeBy: none
			sourceColumn: quarter_start

		column purchase_type
			dataType: string
			summarizeBy: none
			sourceColumn: purchase_type

		column dwelling_type
			dataType: string
			summarizeBy: none
			sourceColumn: dwelling_type

		column hpi_2015
			dataType: double
			formatString: 0.0
			summarizeBy: none
			sourceColumn: hpi_2015

		column yoy_change
			dataType: double
			formatString: +0.0%;-0.0%;0.0%
			summarizeBy: none
			sourceColumn: yoy_change

		partition fct_house_prices = m
			mode: import
			source =
					let
						Source = Parquet.Document ( File.Contents ( DataFolder & "fct_house_prices.parquet" ) ),
						Labelled = Table.AddColumn ( Source, "dwelling_type", each if [purchase_type] = "DW_NEW" then "New dwellings" else if [purchase_type] = "DW_EXST" then "Existing dwellings" else "All dwellings", type text )
					in
						Labelled

	table fct_consumer_prices

		/// Harmonised consumer price index, 2015 = 100, by series (use hicp_series as legend). Runs one quarter past house prices.
		measure 'HICP Index' = AVERAGE ( fct_consumer_prices[hicp_2015] )
			formatString: 0.0
			displayFolder: Prices

		column geo
			dataType: string
			summarizeBy: none
			sourceColumn: geo

		column quarter_start
			dataType: dateTime
			formatString: yyyy-mm-dd
			summarizeBy: none
			sourceColumn: quarter_start

		column coicop
			dataType: string
			summarizeBy: none
			sourceColumn: coicop

		column hicp_series
			dataType: string
			summarizeBy: none
			sourceColumn: hicp_series

		column hicp_2015
			dataType: double
			formatString: 0.0
			summarizeBy: none
			sourceColumn: hicp_2015

		partition fct_consumer_prices = m
			mode: import
			source =
					let
						Source = Parquet.Document ( File.Contents ( DataFolder & "fct_consumer_prices.parquet" ) ),
						Labelled = Table.AddColumn ( Source, "hicp_series", each if [coicop] = "CP041" then "Actual rentals" else "All items", type text )
					in
						Labelled

	table mart_house_prices_real

		/// Last quarter with house price data in the current filter context, as YYYY-Qn.
		measure 'Last Price Quarter' =
				VAR LastQuarter = MAX ( mart_house_prices_real[quarter_start] )
				RETURN
					IF ( NOT ISBLANK ( LastQuarter ), YEAR ( LastQuarter ) & "-Q" & ROUNDUP ( MONTH ( LastQuarter ) / 3, 0 ) )
			displayFolder: Prices

		/// Nominal house price index, 2015 = 100. Average of the quarters in context (one value per country and quarter).
		measure 'House Price Index' = AVERAGE ( mart_house_prices_real[nominal_hpi] )
			formatString: 0.0
			displayFolder: Prices

		/// House price index deflated by the all-items HICP, 2015 = 100.
		measure 'Real House Price Index' = AVERAGE ( mart_house_prices_real[real_hpi] )
			formatString: 0.0
			displayFolder: Prices

		/// HICP actual rentals (CP041), 2015 = 100.
		measure 'Rent Index' = AVERAGE ( mart_house_prices_real[rent_index] )
			formatString: 0.0
			displayFolder: Prices

		/// HICP all items (CP00), 2015 = 100.
		measure 'Consumer Price Index' = AVERAGE ( mart_house_prices_real[cpi_index] )
			formatString: 0.0
			displayFolder: Prices

		/// House price index divided by the rent index, 2015 = 100.
		measure 'Price-to-Rent Index' = AVERAGE ( mart_house_prices_real[price_to_rent_index] )
			formatString: 0.0
			displayFolder: Prices

		/// Nominal index in the last quarter of the current context.
		measure 'House Price Index (Latest)' =
				VAR LastQuarter = MAX ( mart_house_prices_real[quarter_start] )
				RETURN
					CALCULATE ( AVERAGE ( mart_house_prices_real[nominal_hpi] ), mart_house_prices_real[quarter_start] = LastQuarter )
			formatString: 0.0
			displayFolder: Prices

		/// Real index in the last quarter of the current context.
		measure 'Real House Price Index (Latest)' =
				VAR LastQuarter = MAX ( mart_house_prices_real[quarter_start] )
				RETURN
					CALCULATE ( AVERAGE ( mart_house_prices_real[real_hpi] ), mart_house_prices_real[quarter_start] = LastQuarter )
			formatString: 0.0
			displayFolder: Prices

		/// Rent index in the last quarter of the current context.
		measure 'Rent Index (Latest)' =
				VAR LastQuarter = MAX ( mart_house_prices_real[quarter_start] )
				RETURN
					CALCULATE ( AVERAGE ( mart_house_prices_real[rent_index] ), mart_house_prices_real[quarter_start] = LastQuarter )
			formatString: 0.0
			displayFolder: Prices

		/// Nominal change on the same quarter a year earlier, last quarter of the context (computed in dbt).
		measure 'House Price YoY %' =
				VAR LastQuarter = MAX ( mart_house_prices_real[quarter_start] )
				RETURN
					CALCULATE ( AVERAGE ( mart_house_prices_real[nominal_yoy] ), mart_house_prices_real[quarter_start] = LastQuarter )
			formatString: +0.0%;-0.0%;0.0%
			displayFolder: Prices

		/// Real change on the same quarter a year earlier, last quarter of the context (computed in dbt).
		measure 'Real House Price YoY %' =
				VAR LastQuarter = MAX ( mart_house_prices_real[quarter_start] )
				RETURN
					CALCULATE ( AVERAGE ( mart_house_prices_real[real_yoy] ), mart_house_prices_real[quarter_start] = LastQuarter )
			formatString: +0.0%;-0.0%;0.0%
			displayFolder: Prices

		/// Nominal change against the 2015 average.
		measure 'House Price Change Since 2015 %' =
				VAR IndexValue = [House Price Index (Latest)]
				RETURN
					IF ( NOT ISBLANK ( IndexValue ), IndexValue / 100 - 1 )
			formatString: +0.0%;-0.0%;0.0%
			displayFolder: Prices

		/// Real change against the 2015 average.
		measure 'Real House Price Change Since 2015 %' =
				VAR IndexValue = [Real House Price Index (Latest)]
				RETURN
					IF ( NOT ISBLANK ( IndexValue ), IndexValue / 100 - 1 )
			formatString: +0.0%;-0.0%;0.0%
			displayFolder: Prices

		/// Rent change against the 2015 average.
		measure 'Rent Change Since 2015 %' =
				VAR IndexValue = [Rent Index (Latest)]
				RETURN
					IF ( NOT ISBLANK ( IndexValue ), IndexValue / 100 - 1 )
			formatString: +0.0%;-0.0%;0.0%
			displayFolder: Prices

		/// Portugal minus EU-27, nominal index points (2015 = 100), last quarter of the context.
		measure 'Portugal vs EU House Price Gap' =
				VAR Portugal = CALCULATE ( [House Price Index (Latest)], REMOVEFILTERS ( dim_country ), dim_country[geo] = "PT" )
				VAR EU = CALCULATE ( [House Price Index (Latest)], REMOVEFILTERS ( dim_country ), dim_country[geo] = "EU27_2020" )
				RETURN
					IF ( NOT ISBLANK ( Portugal ) && NOT ISBLANK ( EU ), ( Portugal - EU ) )
			formatString: +0.0;-0.0;0.0
			displayFolder: Portugal vs EU

		/// Portugal minus EU-27, real index points (2015 = 100), last quarter of the context.
		measure 'Portugal vs EU Real House Price Gap' =
				VAR Portugal = CALCULATE ( [Real House Price Index (Latest)], REMOVEFILTERS ( dim_country ), dim_country[geo] = "PT" )
				VAR EU = CALCULATE ( [Real House Price Index (Latest)], REMOVEFILTERS ( dim_country ), dim_country[geo] = "EU27_2020" )
				RETURN
					IF ( NOT ISBLANK ( Portugal ) && NOT ISBLANK ( EU ), ( Portugal - EU ) )
			formatString: +0.0;-0.0;0.0
			displayFolder: Portugal vs EU

		column geo
			dataType: string
			summarizeBy: none
			sourceColumn: geo

		column quarter_start
			dataType: dateTime
			formatString: yyyy-mm-dd
			summarizeBy: none
			sourceColumn: quarter_start

		column nominal_hpi
			dataType: double
			formatString: 0.0
			summarizeBy: none
			sourceColumn: nominal_hpi

		column real_hpi
			dataType: double
			formatString: 0.0
			summarizeBy: none
			sourceColumn: real_hpi

		column rent_index
			dataType: double
			formatString: 0.0
			summarizeBy: none
			sourceColumn: rent_index

		column cpi_index
			dataType: double
			formatString: 0.0
			summarizeBy: none
			sourceColumn: cpi_index

		column price_to_rent_index
			dataType: double
			formatString: 0.0
			summarizeBy: none
			sourceColumn: price_to_rent_index

		column nominal_yoy
			dataType: double
			formatString: +0.0%;-0.0%;0.0%
			summarizeBy: none
			sourceColumn: nominal_yoy

		column real_yoy
			dataType: double
			formatString: +0.0%;-0.0%;0.0%
			summarizeBy: none
			sourceColumn: real_yoy

		partition mart_house_prices_real = m
			mode: import
			source =
					let
						Source = Parquet.Document ( File.Contents ( DataFolder & "mart_house_prices_real.parquet" ) )
					in
						Source

	table fct_living_conditions

		/// Overburden rate by income group (use income_group_name as legend), by survey year.
		measure 'Overburden Rate by Group %' =
				CALCULATE (
					DIVIDE ( AVERAGE ( fct_living_conditions[value] ), 100 ),
					fct_living_conditions[indicator] = "overburden_rate"
				)
			formatString: 0.0%
			displayFolder: Affordability

		column geo
			dataType: string
			summarizeBy: none
			sourceColumn: geo

		column survey_year
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: survey_year

		column indicator
			dataType: string
			summarizeBy: none
			sourceColumn: indicator

		column income_group
			dataType: string
			summarizeBy: none
			sourceColumn: income_group

		column income_group_name
			dataType: string
			summarizeBy: none
			sourceColumn: income_group_name

		column value
			dataType: double
			formatString: #,0.0
			summarizeBy: none
			sourceColumn: value

		partition fct_living_conditions = m
			mode: import
			source =
					let
						Source = Parquet.Document ( File.Contents ( DataFolder & "fct_living_conditions.parquet" ) ),
						Labelled = Table.AddColumn ( Source, "income_group_name", each if [income_group] = "B_60" then "Below 60% of median income" else if [income_group] = "A_60" then "Above 60% of median income" else "All people", type text )
					in
						Labelled

	table mart_affordability

		/// Average of the four quarterly nominal indices of the year, 2015 = 100.
		measure 'Annual House Price Index' = AVERAGE ( mart_affordability[hpi_2015] )
			formatString: 0.0
			displayFolder: Affordability

		/// Median equivalised net income, aligned to the income year (EU-SILC survey year minus one).
		measure 'Median Income (EUR)' = AVERAGE ( mart_affordability[median_income_eur] )
			formatString: #,0
			displayFolder: Affordability

		/// Median income, 2015 = 100.
		measure 'Income Index' = AVERAGE ( mart_affordability[income_2015] )
			formatString: 0.0
			displayFolder: Affordability

		/// Annual house price index divided by the income index, 2015 = 100. Above 100: prices grew faster than incomes.
		measure 'Price-to-Income Index' = AVERAGE ( mart_affordability[price_to_income_index] )
			formatString: 0.0
			displayFolder: Affordability

		/// Last year with a price-to-income index in context (2024 in the current data).
		measure 'Price-to-Income Year' = CALCULATE ( MAX ( mart_affordability[year] ), NOT ISBLANK ( mart_affordability[price_to_income_index] ) )
			formatString: 0
			displayFolder: Affordability

		/// Price-to-income index in its last available year.
		measure 'Price-to-Income Index (Latest)' =
				VAR LastYear = [Price-to-Income Year]
				RETURN
					CALCULATE ( [Price-to-Income Index], mart_affordability[year] = LastYear )
			formatString: 0.0
			displayFolder: Affordability

		/// Annual house price change since 2015, in the last year that also has income.
		measure 'Price Growth Since 2015 % (Income Year)' =
				VAR LastYear = [Price-to-Income Year]
				VAR IndexValue = CALCULATE ( [Annual House Price Index], mart_affordability[year] = LastYear )
				RETURN
					IF ( NOT ISBLANK ( IndexValue ), IndexValue / 100 - 1 )
			formatString: +0.0%;-0.0%;0.0%
			displayFolder: Affordability

		/// Median income change since 2015, in the last year with income.
		measure 'Income Growth Since 2015 %' =
				VAR LastYear = [Price-to-Income Year]
				VAR IndexValue = CALCULATE ( [Income Index], mart_affordability[year] = LastYear )
				RETURN
					IF ( NOT ISBLANK ( IndexValue ), IndexValue / 100 - 1 )
			formatString: +0.0%;-0.0%;0.0%
			displayFolder: Affordability

		/// Share of people in households spending over 40% of disposable income on housing, by survey year.
		measure 'Overburden Rate %' = DIVIDE ( AVERAGE ( mart_affordability[overburden_total] ), 100 )
			formatString: 0.0%
			displayFolder: Affordability

		/// Overburden rate for people below 60% of the national median income.
		measure 'Low-Income Overburden Rate %' = DIVIDE ( AVERAGE ( mart_affordability[overburden_poor] ), 100 )
			formatString: 0.0%
			displayFolder: Affordability

		/// Last EU-SILC survey year with an overburden rate in context (2025 in the current data).
		measure 'Overburden Year' = CALCULATE ( MAX ( mart_affordability[year] ), NOT ISBLANK ( mart_affordability[overburden_total] ) )
			formatString: 0
			displayFolder: Affordability

		/// Overburden rate in its last available survey year.
		measure 'Overburden Rate % (Latest)' =
				VAR LastYear = [Overburden Year]
				RETURN
					CALCULATE ( [Overburden Rate %], mart_affordability[year] = LastYear )
			formatString: 0.0%
			displayFolder: Affordability

		/// Portugal minus EU-27, price-to-income index points, last available year.
		measure 'Portugal vs EU Price-to-Income Gap' =
				VAR Portugal = CALCULATE ( [Price-to-Income Index (Latest)], REMOVEFILTERS ( dim_country ), dim_country[geo] = "PT" )
				VAR EU = CALCULATE ( [Price-to-Income Index (Latest)], REMOVEFILTERS ( dim_country ), dim_country[geo] = "EU27_2020" )
				RETURN
					IF ( NOT ISBLANK ( Portugal ) && NOT ISBLANK ( EU ), ( Portugal - EU ) )
			formatString: +0.0;-0.0;0.0
			displayFolder: Portugal vs EU

		/// Portugal minus EU-27, percentage points, last available survey year.
		measure 'Portugal vs EU Overburden Gap (pp)' =
				VAR Portugal = CALCULATE ( [Overburden Rate % (Latest)], REMOVEFILTERS ( dim_country ), dim_country[geo] = "PT" )
				VAR EU = CALCULATE ( [Overburden Rate % (Latest)], REMOVEFILTERS ( dim_country ), dim_country[geo] = "EU27_2020" )
				RETURN
					IF ( NOT ISBLANK ( Portugal ) && NOT ISBLANK ( EU ), ( Portugal - EU ) * 100 )
			formatString: +0.0;-0.0;0.0
			displayFolder: Portugal vs EU

		column geo
			dataType: string
			summarizeBy: none
			sourceColumn: geo

		column year
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: year

		column hpi_2015
			dataType: double
			formatString: 0.0
			summarizeBy: none
			sourceColumn: hpi_2015

		column median_income_eur
			dataType: double
			formatString: #,0
			summarizeBy: none
			sourceColumn: median_income_eur

		column income_2015
			dataType: double
			formatString: 0.0
			summarizeBy: none
			sourceColumn: income_2015

		column price_to_income_index
			dataType: double
			formatString: 0.0
			summarizeBy: none
			sourceColumn: price_to_income_index

		column overburden_total
			dataType: double
			formatString: 0.0
			summarizeBy: none
			sourceColumn: overburden_total

		column overburden_poor
			dataType: double
			formatString: 0.0
			summarizeBy: none
			sourceColumn: overburden_poor

		partition mart_affordability = m
			mode: import
			source =
					let
						Source = Parquet.Document ( File.Contents ( DataFolder & "mart_affordability.parquet" ) )
					in
						Source

	table fct_building_permits

		/// Dwellings in residential buildings authorised by building permits.
		measure 'Permitted Dwellings' = SUM ( fct_building_permits[dwellings_permitted] )
			formatString: #,0
			displayFolder: Supply

		/// Last year with permit data in context.
		measure 'Permits Year' = CALCULATE ( MAX ( fct_building_permits[year] ), NOT ISBLANK ( fct_building_permits[dwellings_permitted] ) )
			formatString: 0
			displayFolder: Supply

		/// Dwellings permitted in the last year of the context.
		measure 'Permitted Dwellings (Latest)' =
				VAR LastYear = [Permits Year]
				RETURN
					CALCULATE ( [Permitted Dwellings], fct_building_permits[year] = LastYear )
			formatString: #,0
			displayFolder: Supply

		/// Latest year against 2005, the start of the series and the pre-crisis level.
		measure 'Permits vs 2005 %' =
				VAR Latest = [Permitted Dwellings (Latest)]
				VAR Base2005 = CALCULATE ( [Permitted Dwellings], REMOVEFILTERS ( dim_year ), fct_building_permits[year] = 2005 )
				RETURN
					IF ( NOT ISBLANK ( Latest ) && NOT ISBLANK ( Base2005 ), Latest / Base2005 - 1 )
			formatString: +0.0%;-0.0%;0.0%
			displayFolder: Supply

		/// Latest year divided by the lowest year of the series (2014 for Portugal).
		measure 'Permits Multiple of Low' =
				VAR Latest = [Permitted Dwellings (Latest)]
				VAR Low = MINX ( ALL ( dim_year[year] ), CALCULATE ( [Permitted Dwellings] ) )
				RETURN
					DIVIDE ( Latest, Low )
			formatString: 0.0
			displayFolder: Supply

		column geo
			dataType: string
			summarizeBy: none
			sourceColumn: geo

		column year
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: year

		column dwellings_permitted
			dataType: double
			formatString: #,0
			summarizeBy: none
			sourceColumn: dwellings_permitted

		partition fct_building_permits = m
			mode: import
			source =
					let
						Source = Parquet.Document ( File.Contents ( DataFolder & "fct_building_permits.parquet" ) )
					in
						Source

	relationship fct_house_prices_country
		fromColumn: fct_house_prices.geo
		toColumn: dim_country.geo

	relationship fct_house_prices_quarter
		fromColumn: fct_house_prices.quarter_start
		toColumn: dim_quarter.quarter_start

	relationship fct_consumer_prices_country
		fromColumn: fct_consumer_prices.geo
		toColumn: dim_country.geo

	relationship fct_consumer_prices_quarter
		fromColumn: fct_consumer_prices.quarter_start
		toColumn: dim_quarter.quarter_start

	relationship mart_house_prices_real_country
		fromColumn: mart_house_prices_real.geo
		toColumn: dim_country.geo

	relationship mart_house_prices_real_quarter
		fromColumn: mart_house_prices_real.quarter_start
		toColumn: dim_quarter.quarter_start

	relationship dim_quarter_year
		fromColumn: dim_quarter.year
		toColumn: dim_year.year

	relationship fct_living_conditions_country
		fromColumn: fct_living_conditions.geo
		toColumn: dim_country.geo

	relationship fct_living_conditions_year
		fromColumn: fct_living_conditions.survey_year
		toColumn: dim_year.year

	relationship mart_affordability_country
		fromColumn: mart_affordability.geo
		toColumn: dim_country.geo

	relationship mart_affordability_year
		fromColumn: mart_affordability.year
		toColumn: dim_year.year

	relationship fct_building_permits_country
		fromColumn: fct_building_permits.geo
		toColumn: dim_country.geo

	relationship fct_building_permits_year
		fromColumn: fct_building_permits.year
		toColumn: dim_year.year
