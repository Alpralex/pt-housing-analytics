table dim_year

	column year
		dataType: int64
		isKey
		formatString: 0
		summarizeBy: none
		sourceColumn: year

	partition dim_year = m
		mode: import
		source =
				let
					Quarters = Parquet.Document ( File.Contents ( DataFolder & "dim_quarter.parquet" ) ),
					Annual = Parquet.Document ( File.Contents ( DataFolder & "mart_affordability.parquet" ) ),
					AllYears = List.Combine ( { Quarters[year], Annual[year] } ),
					FirstYear = List.Min ( AllYears ),
					LastYear = List.Max ( AllYears ),
					Source = Table.FromColumns ( { { FirstYear .. LastYear } }, type table [ year = Int64.Type ] )
				in
					Source
