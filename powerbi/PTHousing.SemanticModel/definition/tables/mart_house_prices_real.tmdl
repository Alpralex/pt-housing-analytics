table mart_house_prices_real

	/// Last quarter with house price data in the current filter context, as YYYY-Qn.
	measure 'Last Price Quarter' =
			VAR LastQuarter = MAX ( mart_house_prices_real[quarter_start] )
			RETURN
				IF ( NOT ISBLANK ( LastQuarter ), YEAR ( LastQuarter ) & "-Q" & ROUNDUP ( MONTH ( LastQuarter ) / 3, 0 ) )
		displayFolder: Prices

	/// Nominal house price index, 2015 = 100. Average of the quarters in context (one value per country and quarter).
	measure 'House Price Index' = AVERAGE ( mart_house_prices_real[nominal_hpi] )
		formatString: 0.0
		displayFolder: Prices

	/// House price index deflated by the all-items HICP, 2015 = 100.
	measure 'Real House Price Index' = AVERAGE ( mart_house_prices_real[real_hpi] )
		formatString: 0.0
		displayFolder: Prices

	/// HICP actual rentals (CP041), 2015 = 100.
	measure 'Rent Index' = AVERAGE ( mart_house_prices_real[rent_index] )
		formatString: 0.0
		displayFolder: Prices

	/// HICP all items (CP00), 2015 = 100.
	measure 'Consumer Price Index' = AVERAGE ( mart_house_prices_real[cpi_index] )
		formatString: 0.0
		displayFolder: Prices

	/// House price index divided by the rent index, 2015 = 100.
	measure 'Price-to-Rent Index' = AVERAGE ( mart_house_prices_real[price_to_rent_index] )
		formatString: 0.0
		displayFolder: Prices

	/// Nominal index in the last quarter of the current context.
	measure 'House Price Index (Latest)' =
			VAR LastQuarter = MAX ( mart_house_prices_real[quarter_start] )
			RETURN
				CALCULATE ( AVERAGE ( mart_house_prices_real[nominal_hpi] ), mart_house_prices_real[quarter_start] = LastQuarter )
		formatString: 0.0
		displayFolder: Prices

	/// Real index in the last quarter of the current context.
	measure 'Real House Price Index (Latest)' =
			VAR LastQuarter = MAX ( mart_house_prices_real[quarter_start] )
			RETURN
				CALCULATE ( AVERAGE ( mart_house_prices_real[real_hpi] ), mart_house_prices_real[quarter_start] = LastQuarter )
		formatString: 0.0
		displayFolder: Prices

	/// Rent index in the last quarter of the current context.
	measure 'Rent Index (Latest)' =
			VAR LastQuarter = MAX ( mart_house_prices_real[quarter_start] )
			RETURN
				CALCULATE ( AVERAGE ( mart_house_prices_real[rent_index] ), mart_house_prices_real[quarter_start] = LastQuarter )
		formatString: 0.0
		displayFolder: Prices

	/// Nominal change on the same quarter a year earlier, last quarter of the context (computed in dbt).
	measure 'House Price YoY %' =
			VAR LastQuarter = MAX ( mart_house_prices_real[quarter_start] )
			RETURN
				CALCULATE ( AVERAGE ( mart_house_prices_real[nominal_yoy] ), mart_house_prices_real[quarter_start] = LastQuarter )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Prices

	/// Real change on the same quarter a year earlier, last quarter of the context (computed in dbt).
	measure 'Real House Price YoY %' =
			VAR LastQuarter = MAX ( mart_house_prices_real[quarter_start] )
			RETURN
				CALCULATE ( AVERAGE ( mart_house_prices_real[real_yoy] ), mart_house_prices_real[quarter_start] = LastQuarter )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Prices

	/// Nominal change against the 2015 average.
	measure 'House Price Change Since 2015 %' =
			VAR IndexValue = [House Price Index (Latest)]
			RETURN
				IF ( NOT ISBLANK ( IndexValue ), IndexValue / 100 - 1 )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Prices

	/// Real change against the 2015 average.
	measure 'Real House Price Change Since 2015 %' =
			VAR IndexValue = [Real House Price Index (Latest)]
			RETURN
				IF ( NOT ISBLANK ( IndexValue ), IndexValue / 100 - 1 )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Prices

	/// Rent change against the 2015 average.
	measure 'Rent Change Since 2015 %' =
			VAR IndexValue = [Rent Index (Latest)]
			RETURN
				IF ( NOT ISBLANK ( IndexValue ), IndexValue / 100 - 1 )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Prices

	/// Portugal minus EU-27, nominal index points (2015 = 100), last quarter of the context.
	measure 'Portugal vs EU House Price Gap' =
			VAR Portugal = CALCULATE ( [House Price Index (Latest)], REMOVEFILTERS ( dim_country ), dim_country[geo] = "PT" )
			VAR EU = CALCULATE ( [House Price Index (Latest)], REMOVEFILTERS ( dim_country ), dim_country[geo] = "EU27_2020" )
			RETURN
				IF ( NOT ISBLANK ( Portugal ) && NOT ISBLANK ( EU ), ( Portugal - EU ) )
		formatString: +0.0;-0.0;0.0
		displayFolder: Portugal vs EU

	/// Portugal minus EU-27, real index points (2015 = 100), last quarter of the context.
	measure 'Portugal vs EU Real House Price Gap' =
			VAR Portugal = CALCULATE ( [Real House Price Index (Latest)], REMOVEFILTERS ( dim_country ), dim_country[geo] = "PT" )
			VAR EU = CALCULATE ( [Real House Price Index (Latest)], REMOVEFILTERS ( dim_country ), dim_country[geo] = "EU27_2020" )
			RETURN
				IF ( NOT ISBLANK ( Portugal ) && NOT ISBLANK ( EU ), ( Portugal - EU ) )
		formatString: +0.0;-0.0;0.0
		displayFolder: Portugal vs EU

	column geo
		dataType: string
		summarizeBy: none
		sourceColumn: geo

	column quarter_start
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: quarter_start

	column nominal_hpi
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: nominal_hpi

	column real_hpi
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: real_hpi

	column rent_index
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: rent_index

	column cpi_index
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: cpi_index

	column price_to_rent_index
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: price_to_rent_index

	column nominal_yoy
		dataType: double
		formatString: +0.0%;-0.0%;0.0%
		summarizeBy: none
		sourceColumn: nominal_yoy

	column real_yoy
		dataType: double
		formatString: +0.0%;-0.0%;0.0%
		summarizeBy: none
		sourceColumn: real_yoy

	partition mart_house_prices_real = m
		mode: import
		source =
				let
					Source = Parquet.Document ( File.Contents ( DataFolder & "mart_house_prices_real.parquet" ) )
				in
					Source
