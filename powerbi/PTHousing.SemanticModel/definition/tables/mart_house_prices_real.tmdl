table mart_house_prices_real
	lineageTag: 2006c891-824a-446e-b88f-199a8aa4efd6

	/// Last quarter with house price data in the current filter context, as YYYY-Qn.
	measure 'Last Price Quarter' =
			VAR LastQuarter = MAX ( mart_house_prices_real[quarter_start] )
			RETURN
				IF ( NOT ISBLANK ( LastQuarter ), YEAR ( LastQuarter ) & "-Q" & ROUNDUP ( MONTH ( LastQuarter ) / 3, 0 ) )
		formatString: General
		displayFolder: Prices
		lineageTag: ae8f853f-9e65-4f3f-8359-2c4c2d85c69e

	/// Nominal house price index, 2015 = 100. Average of the quarters in context (one value per country and quarter).
	measure 'House Price Index' = AVERAGE ( mart_house_prices_real[nominal_hpi] )
		formatString: 0.0
		displayFolder: Prices
		lineageTag: 1754ac3a-efe9-4e42-beb8-4238b334a613

	/// House price index deflated by the all-items HICP, 2015 = 100.
	measure 'Real House Price Index' = AVERAGE ( mart_house_prices_real[real_hpi] )
		formatString: 0.0
		displayFolder: Prices
		lineageTag: 470be931-4026-46f5-8f0d-554c0d24e41a

	/// HICP actual rentals (CP041), 2015 = 100.
	measure 'Rent Index' = AVERAGE ( mart_house_prices_real[rent_index] )
		formatString: 0.0
		displayFolder: Prices
		lineageTag: f8b8f345-0c6d-431d-91a8-eaa646dc4f51

	/// HICP all items (CP00), 2015 = 100.
	measure 'Consumer Price Index' = AVERAGE ( mart_house_prices_real[cpi_index] )
		formatString: 0.0
		displayFolder: Prices
		lineageTag: b465827a-b4e8-4f48-b989-ef991fd1a058

	/// House price index divided by the rent index, 2015 = 100.
	measure 'Price-to-Rent Index' = AVERAGE ( mart_house_prices_real[price_to_rent_index] )
		formatString: 0.0
		displayFolder: Prices
		lineageTag: 551c7b74-d1d0-41f5-8e97-962ffc731991

	/// Nominal index in the last quarter of the current context.
	measure 'House Price Index (Latest)' =
			VAR LastQuarter = MAX ( mart_house_prices_real[quarter_start] )
			RETURN
				CALCULATE ( AVERAGE ( mart_house_prices_real[nominal_hpi] ), mart_house_prices_real[quarter_start] = LastQuarter )
		formatString: 0.0
		displayFolder: Prices
		lineageTag: f9e58948-9d36-417c-af93-2e295eaacc5f

	/// Real index in the last quarter of the current context.
	measure 'Real House Price Index (Latest)' =
			VAR LastQuarter = MAX ( mart_house_prices_real[quarter_start] )
			RETURN
				CALCULATE ( AVERAGE ( mart_house_prices_real[real_hpi] ), mart_house_prices_real[quarter_start] = LastQuarter )
		formatString: 0.0
		displayFolder: Prices
		lineageTag: ad3d00cd-4148-428e-99d0-fb7e8f3d43b0

	/// Rent index in the last quarter of the current context.
	measure 'Rent Index (Latest)' =
			VAR LastQuarter = MAX ( mart_house_prices_real[quarter_start] )
			RETURN
				CALCULATE ( AVERAGE ( mart_house_prices_real[rent_index] ), mart_house_prices_real[quarter_start] = LastQuarter )
		formatString: 0.0
		displayFolder: Prices
		lineageTag: 139a1342-ea09-404c-a4cc-48e3093215a2

	/// Nominal change on the same quarter a year earlier, last quarter of the context (computed in dbt).
	measure 'House Price YoY %' =
			VAR LastQuarter = MAX ( mart_house_prices_real[quarter_start] )
			RETURN
				CALCULATE ( AVERAGE ( mart_house_prices_real[nominal_yoy] ), mart_house_prices_real[quarter_start] = LastQuarter )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Prices
		lineageTag: 6e8f51fc-8ced-4977-b245-c9f151548aa5

	/// Real change on the same quarter a year earlier, last quarter of the context (computed in dbt).
	measure 'Real House Price YoY %' =
			VAR LastQuarter = MAX ( mart_house_prices_real[quarter_start] )
			RETURN
				CALCULATE ( AVERAGE ( mart_house_prices_real[real_yoy] ), mart_house_prices_real[quarter_start] = LastQuarter )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Prices
		lineageTag: f4e4bfaa-6fb1-4e0b-b1dd-118729bc2132

	/// Nominal change against the 2015 average.
	measure 'House Price Change Since 2015 %' =
			VAR IndexValue = [House Price Index (Latest)]
			RETURN
				IF ( NOT ISBLANK ( IndexValue ), IndexValue / 100 - 1 )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Prices
		lineageTag: 5786498f-d5f9-4844-b880-1839a768823e

	/// Real change against the 2015 average.
	measure 'Real House Price Change Since 2015 %' =
			VAR IndexValue = [Real House Price Index (Latest)]
			RETURN
				IF ( NOT ISBLANK ( IndexValue ), IndexValue / 100 - 1 )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Prices
		lineageTag: 0204680d-dafd-45aa-938b-51e675440936

	/// Rent change against the 2015 average.
	measure 'Rent Change Since 2015 %' =
			VAR IndexValue = [Rent Index (Latest)]
			RETURN
				IF ( NOT ISBLANK ( IndexValue ), IndexValue / 100 - 1 )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Prices
		lineageTag: dc3bbbda-7843-43c4-a661-d0b41b4fa1b5

	/// Portugal minus EU-27, nominal index points (2015 = 100), last quarter of the context.
	measure 'Portugal vs EU House Price Gap' =
			VAR Portugal = CALCULATE ( [House Price Index (Latest)], REMOVEFILTERS ( dim_country ), dim_country[geo] = "PT" )
			VAR EU = CALCULATE ( [House Price Index (Latest)], REMOVEFILTERS ( dim_country ), dim_country[geo] = "EU27_2020" )
			RETURN
				IF ( NOT ISBLANK ( Portugal ) && NOT ISBLANK ( EU ), ( Portugal - EU ) )
		formatString: +0.0;-0.0;0.0
		displayFolder: Portugal vs EU
		lineageTag: f608b43d-29e3-4ed7-b7ab-7cd758d4d528

	/// Portugal minus EU-27, real index points (2015 = 100), last quarter of the context.
	measure 'Portugal vs EU Real House Price Gap' =
			VAR Portugal = CALCULATE ( [Real House Price Index (Latest)], REMOVEFILTERS ( dim_country ), dim_country[geo] = "PT" )
			VAR EU = CALCULATE ( [Real House Price Index (Latest)], REMOVEFILTERS ( dim_country ), dim_country[geo] = "EU27_2020" )
			RETURN
				IF ( NOT ISBLANK ( Portugal ) && NOT ISBLANK ( EU ), ( Portugal - EU ) )
		formatString: +0.0;-0.0;0.0
		displayFolder: Portugal vs EU
		lineageTag: 07f95d03-f1b4-4c99-ad9f-39cdf5c508df

	/// One-sentence answer for the Overview page: the focus country's house price index (Portugal unless one country is selected).
	measure 'Headline Overview' =
			VAR Geo = IF ( HASONEVALUE ( dim_country[geo] ), VALUES ( dim_country[geo] ), "PT" )
			VAR CountryName = CALCULATE ( SELECTEDVALUE ( dim_country[country_name] ), REMOVEFILTERS ( dim_country ), dim_country[geo] = Geo )
			VAR Hpi = CALCULATE ( [House Price Index (Latest)], REMOVEFILTERS ( dim_country ), dim_country[geo] = Geo )
			VAR Yoy = CALCULATE ( [House Price YoY %], REMOVEFILTERS ( dim_country ), dim_country[geo] = Geo )
			VAR Real = CALCULATE ( [Real House Price Index (Latest)], REMOVEFILTERS ( dim_country ), dim_country[geo] = Geo )
			VAR Eu = CALCULATE ( [House Price Index (Latest)], REMOVEFILTERS ( dim_country ), dim_country[geo] = "EU27_2020" )
			VAR Q = CALCULATE ( [Last Price Quarter], REMOVEFILTERS ( dim_country ), dim_country[geo] = Geo )
			RETURN
				IF (
					ISBLANK ( Hpi ),
					"No house price data in this selection.",
					CountryName & ": house prices at " & FORMAT ( Hpi, "0" ) & " in " & Q & " (2015 = 100), " & FORMAT ( Yoy, "+0.0%;-0.0%" )
						& " on a year earlier and " & FORMAT ( Real, "0" ) & " after inflation"
						& IF ( Geo <> "EU27_2020", ". The EU-27 is at " & FORMAT ( Eu, "0" ) & ".", "." )
				)
		isHidden
		displayFolder: Story
		lineageTag: 596e42d2-0795-54ad-a8ab-dc9876365f0b

	/// One-sentence answer for the prices, rents and incomes page: prices against incomes since 2015.
	measure 'Headline Prices' =
			VAR Geo = IF ( HASONEVALUE ( dim_country[geo] ), VALUES ( dim_country[geo] ), "PT" )
			VAR CountryName = CALCULATE ( SELECTEDVALUE ( dim_country[country_name] ), REMOVEFILTERS ( dim_country ), dim_country[geo] = Geo )
			VAR P = CALCULATE ( [Price Growth Since 2015 % (Income Year)], REMOVEFILTERS ( dim_country ), dim_country[geo] = Geo )
			VAR I = CALCULATE ( [Income Growth Since 2015 %], REMOVEFILTERS ( dim_country ), dim_country[geo] = Geo )
			VAR Pti = CALCULATE ( [Price-to-Income Index (Latest)], REMOVEFILTERS ( dim_country ), dim_country[geo] = Geo )
			VAR Eu = CALCULATE ( [Price-to-Income Index (Latest)], REMOVEFILTERS ( dim_country ), dim_country[geo] = "EU27_2020" )
			VAR Y = CALCULATE ( [Price-to-Income Year], REMOVEFILTERS ( dim_country ), dim_country[geo] = Geo )
			RETURN
				IF (
					ISBLANK ( Pti ),
					"No income data in this selection.",
					"From 2015 to " & Y & ", house prices in " & CountryName & " rose " & FORMAT ( P, "+0%;-0%" ) & " and median income "
						& FORMAT ( I, "+0%;-0%" ) & ": price-to-income " & FORMAT ( Pti, "0" )
						& IF ( Geo <> "EU27_2020", ", against " & FORMAT ( Eu, "0" ) & " for the EU-27.", "." )
				)
		isHidden
		displayFolder: Story
		lineageTag: 2c471c75-bb49-5fa4-9f2c-3eb965bbed52

	/// One-sentence answer for the supply and cost burden page: permits against their low and 2005, and the overburden rate.
	measure 'Headline Supply' =
			VAR Geo = IF ( HASONEVALUE ( dim_country[geo] ), VALUES ( dim_country[geo] ), "PT" )
			VAR CountryName = CALCULATE ( SELECTEDVALUE ( dim_country[country_name] ), REMOVEFILTERS ( dim_country ), dim_country[geo] = Geo )
			VAR Permits = CALCULATE ( [Permitted Dwellings (Latest)], REMOVEFILTERS ( dim_country ), dim_country[geo] = Geo )
			VAR PY = CALCULATE ( [Permits Year], REMOVEFILTERS ( dim_country ), dim_country[geo] = Geo )
			VAR Mult = CALCULATE ( [Permits Multiple of Low], REMOVEFILTERS ( dim_country ), dim_country[geo] = Geo )
			VAR Vs2005 = CALCULATE ( [Permits vs 2005 %], REMOVEFILTERS ( dim_country ), dim_country[geo] = Geo )
			VAR Ob = CALCULATE ( [Overburden Rate % (Latest)], REMOVEFILTERS ( dim_country ), dim_country[geo] = Geo )
			VAR ObEu = CALCULATE ( [Overburden Rate % (Latest)], REMOVEFILTERS ( dim_country ), dim_country[geo] = "EU27_2020" )
			RETURN
				IF ( ISBLANK ( Permits ), CountryName & " has no building permit series here (only Portugal, Spain, Ireland and the EU-27). ",
					FORMAT ( Permits, "#,0" ) & " dwellings permitted in " & CountryName & " in " & PY & ": " & FORMAT ( Mult, "0.0" )
						& " times the low of the series, but " & FORMAT ( Vs2005, "+0%;-0%" ) & " on 2005. " )
					& IF (
						NOT ISBLANK ( Ob ),
						FORMAT ( Ob, "0.0%" ) & " of people spend over 40% of their income on housing"
							& IF ( Geo <> "EU27_2020", " (EU-27 " & FORMAT ( ObEu, "0.0%" ) & ").", "." ),
						""
					)
		isHidden
		displayFolder: Story
		lineageTag: 572551ce-d779-5ea8-b350-362459bb246f

	/// Sentence at the top of the Country detail drill-through page.
	measure 'Country Headline' =
			VAR CountryName = SELECTEDVALUE ( dim_country[country_name] )
			VAR Hpi = [House Price Index (Latest)]
			VAR CountryRank = IF ( NOT ISBLANK ( Hpi ), RANKX ( ALL ( dim_country[geo] ), [House Price Index (Latest)] ) )
			VAR N = COUNTROWS ( FILTER ( ALL ( dim_country[geo] ), NOT ISBLANK ( [House Price Index (Latest)] ) ) )
			RETURN
				IF (
					ISBLANK ( CountryName ),
					"Right-click a country on any chart and choose Drill through > Country detail.",
					CountryName & ": house prices " & FORMAT ( Hpi, "0" ) & " (2015 = 100), number " & CountryRank & " of the " & N
						& " shown, " & FORMAT ( [House Price YoY %], "+0.0%;-0.0%" ) & " on a year earlier. Price-to-income "
						& FORMAT ( [Price-to-Income Index (Latest)], "0" ) & ", overburden rate " & FORMAT ( [Overburden Rate % (Latest)], "0.0%" ) & "."
				)
		isHidden
		displayFolder: Story
		lineageTag: 1d4bff06-0592-5d0f-b868-2dbe79017efc

	/// Title of the Overview country chart; follows the Index field parameter.
	measure 'Index Chart Title' =
			VAR Pick = SELECTEDVALUE ( 'Housing Index'[Index Order], 0 )
			RETURN
				SWITCH ( Pick, 1, "House prices", 2, "Rents", 3, "House prices against rents", "Real house prices" ) & " by country (2015 = 100)"
		isHidden
		displayFolder: Story
		lineageTag: 172a4c7e-36b6-5d1f-a3aa-74b2c6cbaf76

	/// Subtitle of the Overview country chart.
	measure 'Index Chart Subtitle' =
			VAR Pick = SELECTEDVALUE ( 'Housing Index'[Index Order], 0 )
			RETURN
				SWITCH (
					Pick,
					1, "Nominal house price index",
					2, "Actual rentals for housing in the consumer price index",
					3, "House price index divided by the rent index",
					"House price index divided by the consumer price index"
				) & ". Portugal in magenta. Change the measure with the Index filter"
		isHidden
		displayFolder: Story
		lineageTag: 75409186-1cbe-5b15-9c2e-7998caa3b632

	column geo
		dataType: string
